{
  "name": "gaiavfx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A portable local-first AI filmmaking workstation",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --config frontend/vite.config.ts --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --config frontend/vite.config.ts --configLoader runner",
    "test:ui": "playwright test",
    "desktop": "node scripts/desktop.mjs",
    "package:win": "node scripts/package.mjs",
    "check:contracts": "node scripts/contracts.mjs --check",
    "generate:contracts": "node scripts/contracts.mjs",
    "setup:media": "node scripts/python.mjs -m gaiavfx.setup media install",
    "check:hygiene": "node scripts/python.mjs scripts/check_hygiene.py",
    "setup": "node scripts/python.mjs -m gaiavfx.setup",
    "doctor": "node scripts/python.mjs -m gaiavfx.setup doctor"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-tooltip": "1.2.16",
    "@sparkjsdev/spark": "2.3.1",
    "@tanstack/react-query": "5.102.8",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.3.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  }
}
